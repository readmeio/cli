{
  "name": "@readme/cli",
  "version": "0.3.1",
  "description": "The ReadMe CLI",
  "keywords": [
    "cli",
    "docs",
    "readme"
  ],
  "license": "ISC",
  "bin": {
    "readme": "./bin/readme.js",
    "readme_": "./bin/readme.js"
  },
  "files": [
    "bin",
    "src",
    "vendor",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./commands/lint": "./src/commands/lint.js",
    "./commands/oas-sync": "./src/commands/oas-sync.js",
    "./commands/oas-validate": "./src/commands/oas-validate.js",
    "./commands/import": "./src/commands/import.js",
    "./commands/pretty": "./src/commands/pretty.js",
    "./prompts": "./src/prompts/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build:gha": "node bin/build-gha.js",
    "format": "npx oxlint --fix && npx oxfmt --write",
    "lint": "npx oxlint && npx oxfmt --check . && npm run schemas:check",
    "pretest": "npm run lint",
    "schemas:check": "./bin/git-format.js",
    "schemas:write": "./bin/git-format.js --update && npx oxfmt --write vendor/git-format/frontmatter.schema.json",
    "start": "node bin/readme.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@readme/markdown": "^13.3.0",
    "@readme/openapi-parser": "^10.0.0",
    "ajv": "^8.18.0",
    "chalk": "^5.4.1",
    "cli-spinners": "^3.4.0",
    "commander": "^13.1.0",
    "js-yaml": "^5.5.0",
    "log-update": "^8.0.0",
    "next": "^15.5.29",
    "oas-normalize": "^18.0.3",
    "ora": "^9.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remove-undefined-objects": "^9.0.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@readme/oxlint-config": "^1.9.0",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@graphql-tools/executor-graphql-ws": {
      "ws": "8.22.1"
    },
    "@graphql-tools/executor-legacy-ws": {
      "ws": "8.22.1"
    },
    "cosmiconfig": {
      "js-yaml": "4.3.2"
    },
    "express-rate-limit": {
      "express": "4.22.3"
    },
    "graphql-config": {
      "minimatch": "4.2.6"
    },
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
