{
  "name": "@readme/cli",
  "version": "0.2.0",
  "description": "The ReadMe CLI",
  "keywords": [
    "cli",
    "docs",
    "readme"
  ],
  "license": "ISC",
  "bin": {
    "readme": "./bin/readme.js",
    "readme_": "./bin/readme.js"
  },
  "files": [
    "bin",
    "src",
    "vendor",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./commands/lint": "./src/commands/lint.js",
    "./commands/oas-sync": "./src/commands/oas-sync.js",
    "./commands/oas-validate": "./src/commands/oas-validate.js",
    "./commands/import": "./src/commands/import.js",
    "./commands/pretty": "./src/commands/pretty.js",
    "./prompts": "./src/prompts/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build:gha": "ncc build src/gha.js -o dist-gha --external @readme/markdown",
    "format": "npx oxlint --fix && npx oxfmt --write",
    "lint": "npx oxlint && npx oxfmt --check .",
    "pretest": "npm run lint",
    "start": "node bin/readme.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@readme/markdown": "^13.3.0",
    "@readme/openapi-parser": "^5.5.0",
    "@readmeio/git-format": "git+https://github.com/readmeio/git-format.git",
    "ajv": "^8.18.0",
    "chalk": "^5.4.1",
    "cli-spinners": "^3.4.0",
    "commander": "^13.1.0",
    "js-yaml": "^5.5.0",
    "log-update": "^8.0.0",
    "next": "^15.0.0",
    "oas-normalize": "^15.7.1",
    "ora": "^9.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remove-undefined-objects": "^9.0.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@readme/oxlint-config": "^1.9.0",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
